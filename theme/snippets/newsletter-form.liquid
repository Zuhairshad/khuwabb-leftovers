{%- comment -%}
  Newsletter form (components/NewsletterForm.tsx). Shopify customer form (G5):
  contact[tags]=newsletter. Parameter: section (the footer section).
  data-state: idle | bad | sending | done. The server result sets the initial
  state (posted_successfully -> done, errors -> bad); assets/footer.js drives
  bad/sending on the client. The form id appends #FooterNewsletter to the
  redirect so the page returns to the footer.
{%- endcomment -%}
{%- liquid
  assign placeholder = section.settings.newsletter_placeholder | default: 'Your email'
  assign button_label = section.settings.newsletter_button | default: 'Subscribe'
  assign success_text = section.settings.newsletter_success | default: 'You’re in. See you in your inbox.'
  assign error_text = section.settings.newsletter_error | default: 'That email doesn’t look right'
-%}
{%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form__shell', novalidate: 'novalidate' -%}
  {%- liquid
    assign state = 'idle'
    if form.posted_successfully?
      assign state = 'done'
    elsif form.errors
      assign state = 'bad'
    endif
  -%}
  <newsletter-form class="newsletter-form" data-code-component data-state="{{ state }}">
    <div class="newsletter-form__form">
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        class="newsletter-form__input"
        type="email"
        name="contact[email]"
        required
        autocomplete="email"
        aria-label="{{ 'newsletter.label' | t }}"
        placeholder="{{ placeholder }}"
        value="{{ form.email }}"
        {% if state == 'done' %}
          disabled
        {% endif %}
      >
      <button class="newsletter-form__button" type="submit">{{ button_label }}</button>
      <div class="newsletter-form__done" aria-live="polite">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {%- if state == 'done' -%}{{ success_text }}{%- endif -%}
      </div>
    </div>
    <div class="newsletter-form__error">{{ error_text }}</div>
  </newsletter-form>
{%- endform -%}
