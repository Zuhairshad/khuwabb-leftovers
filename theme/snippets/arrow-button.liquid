{%- comment -%}
  Pill link with a round arrow badge that turns 45deg on hover/focus (components/ArrowButton.tsx).

  Parameters:
  - href  (required) link target
  - label (required) button text
  - tone  (optional) 'dark' (default) | 'light'
  - class (optional) extra classes appended after "arrow-button"
  - attrs (optional) raw extra HTML attributes, e.g. 'data-foo="bar" target="_blank"' (must already be escaped)

  CSS: this snippet does NOT load its stylesheet. Any section that renders it (or
  section-heading, which renders it) must include once:
    {{ 'component-arrow-button.css' | asset_url | stylesheet_tag }}

  Usage: {% render 'arrow-button', href: routes.all_products_collection_url, label: 'Shop all', tone: 'light' %}
{%- endcomment -%}
{%- liquid
  assign ab_tone = tone | default: 'dark'
  if ab_tone != 'light'
    assign ab_tone = 'dark'
  endif
-%}
<a href="{{ href }}" class="arrow-button{% if class != blank %} {{ class }}{% endif %}" data-tone="{{ ab_tone }}"{% if attrs != blank %} {{ attrs }}{% endif %}>
  <span class="arrow-button__label">{{ label }}</span>
  <span class="arrow-button__badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18L13.125 10.875"/><path d="M8.25 6H18V15.75Z"/></svg></span>
</a>
