{%- comment -%}
  Home hero reels CSS. Used by sections/hero-reels.liquid.
  Inlined (no render-blocking request); rendered at the top of the section. Contains no Liquid and no url() references.
{%- endcomment -%}
<style>
/*
 * Hero reels. Ported rule for rule from components/home/Hero.module.css and
 * components/ScoopReels.module.css (CSS Modules class -> hero-reels__* class).
 * Mapping table: docs/parity/hero-reels.md.
 */

/* Hero.module.css .hero */
.hero-reels {
  position: relative;
  z-index: 0;
  width: 100%;
  height: 100vh;
  min-height: 720px;
  overflow: clip;
  background-color: var(--pistachio);
}

/* .root (<hero-reels> custom element; display:block because custom elements are inline by default) */
.hero-reels__root {
  display: block;
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  transition: background-color 1.4s var(--ease-out);
  color: var(--ink);
  user-select: none;
  -webkit-user-select: none;
  touch-action: pan-y;
  font-family: var(--font-body);
}

.hero-reels__glow {
  position: absolute;
  left: 50%;
  top: 52%;
  width: 70%;
  aspect-ratio: 1 / 1;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0) 72%);
  pointer-events: none;
}

.hero-reels__word {
  position: absolute;
  left: 0;
  right: 0;
  top: 46%;
  transform: translateY(-50%) scale(1.06);
  text-align: center;
  white-space: nowrap;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: min(19vw, 30vh);
  line-height: 1;
  letter-spacing: -0.05em;
  opacity: 0;
  filter: blur(14px);
  transition:
    opacity 1.1s ease,
    filter 1.1s ease,
    transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.hero-reels__word[data-active] {
  transform: translateY(-50%) scale(1);
  opacity: 1;
  filter: blur(0px);
}

.hero-reels__hit {
  position: absolute;
  left: 0;
  right: 0;
  cursor: grab;
}

.hero-reels__track {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-reels__piece {
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: 50% 50%;
  will-change: transform, opacity, filter;
  pointer-events: auto;
  cursor: grab;
  visibility: hidden;
}

.hero-reels__piece img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  pointer-events: none;
  filter: drop-shadow(0 18px 22px rgba(40, 30, 20, 0.16));
}

/* Source sets object-position inline per row (tops 50% 100%, bottoms 50% 0%, shoes 50% 50%). */
.hero-reels__piece[data-row="tops"] img {
  object-position: 50% 100%;
}

.hero-reels__piece[data-row="bottoms"] img {
  object-position: 50% 0%;
}

.hero-reels__tag-slot {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 400;
  pointer-events: none;
  /* Theme addition: hidden until hero-reels.js has positioned it, so no tag flashes at 0,0 before JS. */
  visibility: hidden;
}

.hero-reels__root[data-ready] .hero-reels__tag-slot {
  visibility: visible;
}

.hero-reels__tag {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.62);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow:
    0 1px 2px rgba(0, 0, 0, 0.06),
    0 8px 24px rgba(40, 30, 20, 0.08);
  font-size: 14px;
  line-height: 1.2;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(8px);
  filter: blur(6px);
  transition:
    opacity 0.25s ease,
    transform 0.25s ease,
    filter 0.25s ease;
}

.hero-reels__tag[data-show] {
  opacity: 1;
  transform: translateY(0px);
  filter: blur(0px);
  transition:
    opacity 0.7s ease 0.15s,
    transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s,
    filter 0.7s ease 0.15s;
}

.hero-reels__tag-name {
  opacity: 0.8;
}

.hero-reels__tag-price {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.hero-reels__bar {
  position: absolute;
  left: 32px;
  right: 32px;
  bottom: 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  z-index: 500;
}

.hero-reels__left {
  display: flex;
  align-items: center;
  gap: 14px;
}

.hero-reels__shuffle {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 52px;
  padding: 0 22px 0 6px;
  border-radius: 999px;
  border: none;
  background: var(--ink);
  color: #fbf8f2;
  cursor: pointer;
  font: inherit;
  font-size: 15px;
  font-weight: 600;
  box-shadow: 0 10px 30px rgba(20, 16, 10, 0.18);
}

.hero-reels__dice {
  width: 40px;
  height: 40px;
  border-radius: 999px;
  background: var(--flavour);
  color: var(--ink);
  display: grid;
  place-items: center;
  transition:
    background-color 1.4s ease,
    transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  transform: rotate(0deg);
}

.hero-reels__dice[data-spinning] {
  transform: rotate(180deg);
}

.hero-reels__hint {
  font-size: 14px;
  opacity: 0.6;
}

.hero-reels__right {
  display: flex;
  align-items: center;
  gap: 18px;
}

.hero-reels__total {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  line-height: 1.15;
}

.hero-reels__total-label {
  font-size: 13px;
  opacity: 0.7;
}

.hero-reels__total-value {
  font-size: 22px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  transition: opacity 0.4s ease;
}

.hero-reels__cta {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 52px;
  padding: 0 24px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  color: var(--ink);
  font-size: 15px;
  font-weight: 600;
  box-shadow:
    0 1px 2px rgba(0, 0, 0, 0.06),
    0 10px 30px rgba(40, 30, 20, 0.1);
}

/* Look chooser (<look-chooser>; a custom element, so display is set explicitly) */
.hero-reels__chooser {
  position: absolute;
  right: 32px;
  bottom: 96px;
  z-index: 600;
  width: min(380px, calc(100% - 32px));
  padding: 18px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  gap: 14px;
  user-select: auto;
  -webkit-user-select: auto;
}

.hero-reels__chooser-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
  font-size: 16px;
}

.hero-reels__chooser-head button {
  border: 0;
  background: none;
  font-size: 24px;
  line-height: 1;
  cursor: pointer;
  color: inherit;
}

.hero-reels__chooser-row {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.hero-reels__chooser-name {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 14px;
  font-weight: 500;
}

.hero-reels__chooser-name span {
  flex: none;
  opacity: 0.7;
}

.hero-reels__chooser-picks {
  display: flex;
  gap: 8px;
}

.hero-reels__chooser-picks select {
  flex: 1;
  min-width: 0;
  height: 40px;
  padding: 0 10px;
  border-radius: 12px;
  border: 1px solid var(--ink-line);
  background: #fff;
  font: inherit;
  font-size: 14px;
  color: inherit;
}

.hero-reels__chooser-add {
  height: 48px;
  border: 0;
  border-radius: 999px;
  background: var(--ink);
  color: var(--paper);
  font: inherit;
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
}

.hero-reels__chooser-add:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* Add-to-bag failure message (theme addition; style from Bag.module.css .unavailable: 13px #a8321e) */
.hero-reels__chooser-error {
  font-size: 13px;
  color: #a8321e;
  margin-top: -6px;
}

.hero-reels__chooser-error[hidden] {
  display: none;
}

/* Phone layout (< 640px). A media query rather than the measured width, so
   the first paint already has it. The hero spans the full viewport, so the
   breakpoint is the same. */
@media (max-width: 639.98px) {
  .hero-reels__root .hero-reels__glow {
    width: 120%;
  }

  .hero-reels__root .hero-reels__word {
    top: 40%;
    font-size: 27vw;
  }

  .hero-reels__root .hero-reels__tag {
    padding: 7px 11px;
    font-size: 12px;
  }

  .hero-reels__root .hero-reels__bar {
    left: 16px;
    right: 16px;
    bottom: 18px;
    flex-wrap: wrap;
  }

  .hero-reels__root .hero-reels__shuffle {
    height: 46px;
    padding: 0 18px 0 6px;
    font-size: 14px;
  }

  .hero-reels__root .hero-reels__dice {
    width: 34px;
    height: 34px;
  }

  .hero-reels__root .hero-reels__right {
    gap: 10px;
  }

  .hero-reels__root .hero-reels__total-label {
    font-size: 12px;
  }

  .hero-reels__root .hero-reels__total-value {
    font-size: 18px;
  }

  .hero-reels__root .hero-reels__cta {
    height: 46px;
    padding: 0 18px;
    font-size: 14px;
  }

  .hero-reels__root .hero-reels__chooser {
    right: 16px;
    bottom: 110px;
  }

  .hero-reels__hint {
    display: none;
  }
}

/* Theme addition: reduced motion also drops the CSS transitions (the JS tweens are already 1ms). */
@media (prefers-reduced-motion: reduce) {
  .hero-reels__root,
  .hero-reels__word,
  .hero-reels__tag,
  .hero-reels__tag[data-show],
  .hero-reels__dice,
  .hero-reels__total-value {
    transition-duration: 0.01ms;
    transition-delay: 0s;
  }
}
</style>
