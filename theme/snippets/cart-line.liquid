{%- comment -%}
  One bag line (Bag.tsx:116-145). Used by the drawer and the cart page.
  Params: item (cart line), index (0-based, drives the --i stagger), context ('drawer' | 'page').
  Styles: section-cart-drawer.css (.cart-line*).
{%- endcomment -%}
{%- liquid
  assign colour = ''
  assign size = ''
  for option in item.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'color' or option_name == 'colour'
      assign colour = option.value
    elsif option_name == 'size'
      assign size = option.value
    endif
  endfor
  if colour != blank and size != blank
    assign detail = 'bag.colour_size' | t: colour: colour, size: size
  elsif item.variant.title != blank and item.variant.title != 'Default Title'
    assign detail = item.variant.title
  else
    assign detail = ''
  endif
  assign orderable = item.variant.available
  assign line_name = item.product.title
  if line_name == blank
    assign line_name = 'bag.no_longer_available' | t
  endif
-%}
<div
  class="cart-line cart-line--{{ context | default: 'drawer' }}"
  style="--i: {{ index | default: 0 }}"
  data-line
  data-line-key="{{ item.key }}"
  data-quantity="{{ item.quantity }}"
  {% unless orderable %}data-unavailable{% endunless %}
>
  <div class="cart-line__thumb">
    {%- if item.image -%}
      <img src="{{ item.image | image_url: width: 300 }}" alt="{{ line_name | escape }}" width="300" height="{{ 300 | times: item.image.height | divided_by: item.image.width }}" loading="lazy" decoding="async">
    {%- endif -%}
  </div>
  <div class="cart-line__body">
    <div>
      <div class="cart-line__top">
        <span>{{ line_name }}</span>
        <span class="cart-num">{% render 'price', price: item.final_line_price %}</span>
      </div>
      {%- if detail != blank -%}
        <div class="cart-line__size">{{ detail }}</div>
      {%- endif -%}
      {%- unless orderable -%}
        <div class="cart-line__unavailable">{{ 'bag.not_available' | t }}</div>
      {%- endunless -%}
      <div class="cart-line__error" data-line-error role="alert"></div>
    </div>
    <div class="cart-line__bottom">
      <div class="cart-line__stepper">
        <button type="button" aria-label="{{ 'bag.one_less' | t }}" data-action="dec" data-step="-1">&minus;</button>
        {%- if context == 'page' -%}
          <input class="cart-line__qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="{{ line_name | escape }}" data-qty>
        {%- else -%}
          <span data-qty>{{ item.quantity }}</span>
        {%- endif -%}
        <button type="button" aria-label="{{ 'bag.one_more' | t }}" data-action="inc" data-step="1"{% unless orderable %} disabled{% endunless %}>+</button>
      </div>
      {%- if context == 'page' -%}
        <a class="cart-line__remove" href="{{ item.url_to_remove }}" data-action="remove">{{ 'bag.remove' | t }}</a>
      {%- else -%}
        <button type="button" class="cart-line__remove" data-action="remove">{{ 'bag.remove' | t }}</button>
      {%- endif -%}
    </div>
  </div>
</div>
