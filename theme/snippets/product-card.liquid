{%- comment -%}
  Arch product card (components/shop/ProductGrid.tsx): tinted arch with the front cut-out of the first colour,
  name + price underneath. Cut-out springs (rotate -3deg, scale 1.08, y -6px) on hover (hover-capable devices).

  Parameters:
  - product (required)
  - loading (optional) 'lazy' (default) | 'eager'
  - sizes   (optional) default '(max-width: 809.98px) 45vw, 290px'
  - appear  (optional) true (default) | false. true = card rises in on scroll (data-appear="card", appear.js, amount .15)
  - class   (optional) extra classes on the link
  - index   (optional) position in the grid (e.g. forloop.index0), used only to pick the tint fallback below

  Tint: product.metafields.custom.tint. Blank -> rotate through the pastels lib/catalog.ts gives
  Shopify-only products (TINTS), picked by `index` when given, else `product.id | modulo: 5`
  (lib/catalog.ts: products.json products keep their hand-picked tint; Shopify-only ones rotate).
  CSS: the section must load {{ 'section-main-collection-grid.css' | asset_url | stylesheet_tag }} (product-card rules live there)
  and {{ 'component-product-price.css' | asset_url | stylesheet_tag }}; appear.js is already loaded globally.

  Usage: {% render 'product-card', product: product, loading: 'eager', index: forloop.index0 %}
{%- endcomment -%}
{%- liquid
  assign pc_tints = 'rgb(213, 229, 190)|rgb(246, 201, 207)|rgb(201, 210, 242)|rgb(247, 210, 184)|rgb(245, 231, 166)' | split: '|'
  assign pc_tint = product.metafields.custom.tint.value | default: ''
  if pc_tint == blank
    assign pc_tint_idx = index
    if pc_tint_idx == blank
      assign pc_tint_idx = product.id | modulo: 5
    endif
    assign pc_tint_idx = pc_tint_idx | modulo: 5
    assign pc_tint = pc_tints[pc_tint_idx]
  endif
  assign pc_sizes = sizes | default: '(max-width: 809.98px) 45vw, 290px'
  assign pc_loading = loading | default: 'lazy'

  # Lowest-priced variant's compare-at (lib/catalog.ts shopifyPrices picks the lowest-priced variant's compareAt).
  # (Liquid's `where` compares price as text and never matches, so loop instead.)
  assign pc_compare_at = nil
  for pc_v in product.variants
    if pc_v.price == product.price_min
      assign pc_compare_at = pc_v.compare_at_price
      break
    endif
  endfor
-%}
<a
  href="{{ product.url }}"
  class="product-card{% if class != blank %} {{ class }}{% endif %}"
  {%- unless appear == false %} data-appear="card" data-appear-amount="0.15"{% endunless %}
  draggable="false"
>
  <div class="product-card__card"{% if pc_tint != blank %} style="background: {{ pc_tint | escape }}"{% endif %}>
    <div class="product-card__cutout">
      {%- render 'cutout-image',
        product: product,
        view: 'front',
        widths: '360,480,640',
        sizes: pc_sizes,
        loading: pc_loading,
        decorative: true
      -%}
    </div>
  </div>
  <div class="product-card__info">
    <p class="product-card__name">{{ product.title | escape }}</p>
    <p class="product-card__price">{% render 'product-price', price: product.price, compare_at: pc_compare_at %}</p>
  </div>
</a>
