{%- comment -%}
  Hanger card: hook SVG over a tinted card with the front cut-out, name + price underneath
  (components/home/NewIn.tsx, reused by components/new-in/NewInPage.tsx). The whole link swings
  5deg from the top on hover / keyboard focus.

  Parameters:
  - product  (required)
  - loading  (optional) 'lazy' (default) | 'eager'
  - sizes    (optional) sizes attribute for the cut-out. Default: ticker '206px', grid '(max-width: 809.98px) 90vw, 280px'
  - class    (optional) extra classes on the link (e.g. a grid layout hook)
  - context  (optional) 'ticker' (default) | 'grid'
             ticker: fixed 250px wide, product name on one line with ellipsis.
             grid:   fills its grid cell (width 100%), name wraps, pointer cursor.
             The grid LAYOUT (4/3/2/1 columns, gaps, section wrapper) is NOT in this snippet; see docs/parity/new-arrivals.md "For task 3D".
  - index    (optional) position in the list (e.g. forloop.index0), used only to pick the tint fallback below

  Tint: product.metafields.custom.tint. Blank -> rotate through the pastels lib/catalog.ts gives
  Shopify-only products (TINTS), picked by `index` when given, else `product.id | modulo: 5`
  (replaces the old fixed '#09F' ticker fallback / no-fallback grid case).

  One garment per hanger (components/home/NewIn.tsx hangerPhotoStyle): for `seam-detail-co-ords-set`
  and `gym-co-ords-set` the source photo has the top on the left and the trousers on the right, so
  the cut-out is cropped to just the trousers (right side) instead of showing both pieces.

  CSS: the section must load {{ 'component-hanger-card.css' | asset_url | stylesheet_tag }} and
  {{ 'component-product-price.css' | asset_url | stylesheet_tag }}.
  Cloned copies made by ticker.js get tabindex="-1" and aria-hidden on their wrappers.

  Usage: {% render 'hanger-card', product: product, context: 'ticker', index: forloop.index0 %}
{%- endcomment -%}
{%- liquid
  assign hc_context = context | default: 'ticker'
  assign hc_tints = 'rgb(213, 229, 190)|rgb(246, 201, 207)|rgb(201, 210, 242)|rgb(247, 210, 184)|rgb(245, 231, 166)' | split: '|'
  assign hc_tint = product.metafields.custom.tint.value | default: ''
  if hc_tint == blank
    assign hc_tint_idx = index
    if hc_tint_idx == blank
      assign hc_tint_idx = product.id | modulo: 5
    endif
    assign hc_tint_idx = hc_tint_idx | modulo: 5
    assign hc_tint = hc_tints[hc_tint_idx]
  endif
  assign hc_loading = loading | default: 'lazy'
  if sizes != blank
    assign hc_sizes = sizes
  elsif hc_context == 'grid'
    assign hc_sizes = '(max-width: 809.98px) 90vw, 280px'
  else
    assign hc_sizes = '206px'
  endif

  assign hc_cutout_class = nil
  if product.handle == 'seam-detail-co-ords-set' or product.handle == 'gym-co-ords-set'
    assign hc_cutout_class = 'hanger-card__cutout--one-garment'
  endif

  # Lowest-priced variant's compare-at (lib/catalog.ts shopifyPrices picks the lowest-priced variant's compareAt).
  assign hc_compare_variant = product.variants | where: 'price', product.price_min | first
  assign hc_compare_at = hc_compare_variant.compare_at_price
-%}
<a
  href="{{ product.url }}"
  class="hanger-card hanger-card--{{ hc_context }}{% if class != blank %} {{ class }}{% endif %}"
  draggable="false"
>
  <svg class="hanger-card__hook" viewBox="0 0 120 62" width="120" height="62" fill="none" aria-hidden="true" focusable="false">
    <path d="M60 30V24.5c0-3.2 6.5-4.6 6.5-11a6.5 6.5 0 1 0-13 0" stroke="#17140F" stroke-width="3" stroke-linecap="round"/>
    <path d="M60 30 L10 56.5 c-3.4 1.8-2.4 4.5 1.5 4.5 h97 c3.9 0 4.9-2.7 1.5-4.5 Z" stroke="#17140F" stroke-width="3" stroke-linejoin="round" fill="none"/>
  </svg>
  <div class="hanger-card__card"{% if hc_tint != blank %} style="background: {{ hc_tint | escape }}"{% endif %}>
    {%- comment -%} Decorative: the name is visible text in the same link. {%- endcomment -%}
    {%- render 'cutout-image',
      product: product,
      view: 'front',
      widths: '360,480,640',
      sizes: hc_sizes,
      loading: hc_loading,
      decorative: true,
      class: hc_cutout_class
    -%}
  </div>
  <div class="hanger-card__info">
    <p class="hanger-card__name">{{ product.title | escape }}</p>
    <p class="hanger-card__price">{% render 'product-price', price: product.price, compare_at: hc_compare_at %}</p>
  </div>
</a>
