{%- comment -%}
  Meta tags. Titles follow the reference: home "Khuwabb — Women's pret & couture",
  other pages "<title> · Khuwabb" (docs/audit.md §2). Owned by the main session.
{%- endcomment -%}
{%- liquid
  assign brand = shop.name
  assign tagline = 'meta.home_tagline_html' | t
  assign page_label = 'meta.page' | t: number: current_page
  assign default_description = 'meta.default_description' | t
  if template.name == 'index'
    assign title = brand | append: ' — ' | append: tagline
  elsif template.name == 'collection' and collection.handle == 'all'
    assign title = 'meta.all_collections' | t | append: ' · ' | append: brand
  else
    assign title = page_title | append: ' · ' | append: brand
    if current_tags
      assign title = page_title | append: ' – ' | append: current_tags | join: ', ' | append: ' · ' | append: brand
    endif
    if current_page != 1
      assign title = title | append: ' – ' | append: page_label
    endif
  endif
  assign description = page_description | default: default_description
-%}
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f7f3ec">
<link rel="canonical" href="{{ canonical_url }}">
<title>{{ title | escape }}</title>
<meta name="description" content="{{ description | escape }}">
{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
{%- else -%}
  <link rel="icon" type="image/png" sizes="48x48" href="{{ 'favicon-48.png' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'favicon-180.png' | asset_url }}">
{%- endif -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ title | escape }}">
<meta property="og:description" content="{{ description | escape }}">
{%- if template.name == 'product' -%}
  <meta property="og:type" content="product">
  {%- if product.featured_media -%}
    <meta property="og:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
  {%- endif -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html | escape }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- else -%}
  <meta property="og:type" content="website">
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title | escape }}">
<meta name="twitter:description" content="{{ description | escape }}">
{%- render 'structured-data' -%}
