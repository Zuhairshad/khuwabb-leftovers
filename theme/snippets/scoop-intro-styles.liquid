{%- comment -%}
  Scoop intro overlay CSS (components/ScoopIntro.module.css + app/globals.css si* keyframes).
  Inlined in <head> so the intro overlay is styled before first paint (no flash of
  the page under it). Rendered from layout/theme.liquid right after head-styles.
  Used by sections/scoop-intro.liquid. Contains no Liquid and no url() references. Frames are <img> (fetchpriority=low), not backgrounds.
{%- endcomment -%}
<style>
/* Scoop intro (components/ScoopIntro.module.css + app/globals.css si* keyframes).
   Hidden unless head-config set html[data-intro-playing]. */
.scoop-intro {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 10000;
  overflow: hidden;
  background-color: var(--paper);
  pointer-events: none;
  align-items: center;
  justify-content: center;
}

html[data-intro-playing] .scoop-intro {
  display: flex;
}

@media (prefers-reduced-motion: no-preference) {
  html[data-intro-playing]:has(.scoop-intro[data-lock]) {
    overflow: hidden;
  }
}

.scoop-intro__row {
  display: flex;
  gap: min(1.4vw, 16px);
  align-items: center;
}

.scoop-intro__arch {
  position: relative;
  width: var(--arch-w);
  height: calc(var(--arch-w) * 1.38);
  border-radius: 999px 999px 22px 22px;
  overflow: hidden;
  opacity: 0;
}

.scoop-intro__reel {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  flex-direction: column;
  will-change: transform, filter;
}

.scoop-intro__cell {
  flex: 1 1 0;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scoop-intro__frame {
  width: 78%;
  height: 78%;
  display: block;
  max-width: none;
  object-fit: contain;
  object-position: center;
  pointer-events: none;
  user-select: none;
}

.scoop-intro__letter {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: calc(var(--arch-w) * 1.05);
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--ink);
  transform: translateY(4%);
}

@keyframes siIn {
  from {
    transform: translateY(40px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes siSpin {
  0% {
    transform: translateY(0);
    filter: blur(0px);
  }
  12% {
    filter: blur(7px);
  }
  70% {
    filter: blur(3px);
  }
  86% {
    transform: translateY(var(--spin-overshoot));
    filter: blur(0px);
  }
  100% {
    transform: translateY(var(--spin-end));
    filter: blur(0px);
  }
}

@keyframes siUp {
  to {
    transform: translateY(-115vh);
  }
}

@keyframes siDown {
  to {
    transform: translateY(115vh);
  }
}

@keyframes siOut {
  0% {
    opacity: 1;
    visibility: visible;
  }
  99% {
    opacity: 0;
    visibility: visible;
  }
  100% {
    opacity: 0;
    visibility: hidden;
  }
}

@keyframes siBg {
  to {
    background-color: transparent;
  }
}

@media (prefers-reduced-motion: reduce) {
  [data-intro] {
    animation: siOut 0.8s ease forwards !important;
  }
  [data-intro] * {
    animation: none !important;
    filter: none !important;
  }
}
</style>
