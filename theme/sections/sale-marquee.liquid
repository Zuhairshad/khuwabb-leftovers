{%- comment -%}
  Sale marquee: a full-width, ever-scrolling link under the hero
  (components/home/SaleMarquee.tsx). Two copies of a group of 5 messages sit
  side by side in a track twice the viewport's width; the track slides
  translateX(-50%) so the loop never shows a seam.
{%- endcomment -%}
{{ 'section-sale-marquee.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sm_highlight = section.settings.highlight | default: '20% off'
  assign sm_text = section.settings.text | default: 'Export factory leftovers'
  assign sm_link = section.settings.link | default: '/collections/all'
  assign sm_speed = section.settings.speed | default: 32
-%}

<a
  href="{{ sm_link }}"
  class="sale-marquee"
  data-section="sale-marquee"
  style="--sale-marquee-speed: {{ sm_speed }}s"
  aria-label="Shop {{ sm_text | downcase }}, {{ sm_highlight | downcase }}"
>
  {%- comment -%} Shown instead of the track under prefers-reduced-motion. {%- endcomment -%}
  <span class="sale-marquee__static" aria-hidden="true">{{ sm_highlight }} · {{ sm_text }}</span>
  <span class="sale-marquee__track" aria-hidden="true">
    {%- for sm_copy in (1..2) -%}
      <span class="sale-marquee__group">
        {%- for sm_item in (1..5) -%}
          <span class="sale-marquee__message">
            <strong>{{ sm_highlight }}</strong>
            <span class="sale-marquee__dot">✦</span>
            <span>{{ sm_text }}</span>
            <span class="sale-marquee__dot">✦</span>
          </span>
        {%- endfor -%}
      </span>
    {%- endfor -%}
  </span>
</a>

{% schema %}
{
  "name": "Sale marquee",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "highlight", "label": "Highlight text", "default": "20% off" },
    { "type": "text", "id": "text", "label": "Message", "default": "Export factory leftovers" },
    { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" },
    { "type": "range", "id": "speed", "label": "Scroll speed", "info": "Seconds for one full loop. Lower is faster.", "min": 10, "max": 60, "step": 1, "unit": "s", "default": 32 }
  ],
  "presets": [{ "name": "Sale marquee" }]
}
{% endschema %}
