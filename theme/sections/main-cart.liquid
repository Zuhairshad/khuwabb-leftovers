{{ 'section-cart-drawer.css' | asset_url | stylesheet_tag }}
{{ 'section-main-cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign count = cart.item_count
  assign subtotal = 0
  assign unavailable = 0
  for item in cart.items
    if item.variant.available
      assign subtotal = subtotal | plus: item.final_line_price
    else
      assign unavailable = unavailable | plus: 1
    endif
  endfor

  assign ready = false
  if count == 0
    assign note = 'bag.empty' | t
  elsif unavailable > 0
    assign note = 'bag.note_unavailable' | t
  elsif settings.checkout_enabled == false
    assign note = 'bag.note_paused' | t
  else
    assign ready = true
    assign note = section.settings.note_ready
  endif
-%}

<div class="main-cart" data-section="main-cart">
  <h1 class="main-cart__title">
    {{ section.settings.title | escape }} <span class="main-cart__count">{% if count > 0 %}{{ count }}{% endif %}</span>
  </h1>

  {%- if count == 0 -%}
    <div class="cart-drawer__empty main-cart__empty">
      <div class="cart-drawer__empty-arch">
        <img src="{{ 'empty-bag.webp' | asset_url }}" alt="" width="320" height="400" loading="lazy" decoding="async">
      </div>
      <div class="cart-drawer__empty-text">{{ section.settings.empty_text | escape }}</div>
      <a href="{{ section.settings.empty_cta_link | default: routes.all_products_collection_url }}" class="cart-drawer__empty-cta">
        {{ section.settings.empty_cta_label | escape }}
      </a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="main-cart__form" id="MainCartForm" novalidate>
      <div class="main-cart__list">
        {%- for item in cart.items -%}
          {%- render 'cart-line', item: item, index: forloop.index0, context: 'page' -%}
        {%- endfor -%}
      </div>

      <div class="main-cart__foot cart-drawer__foot">
        <div class="cart-drawer__subtotal">
          <span>{{ 'bag.subtotal' | t }}</span>
          <span class="cart-num">{% render 'price', price: subtotal %}</span>
        </div>
        <div class="cart-drawer__note" data-checkout-note>{{ note | escape }}</div>
        <button type="submit" name="update" value="" class="visually-hidden" tabindex="-1" aria-hidden="true" data-update></button>
        <noscript>
          <button type="submit" name="update" class="main-cart__update">{{ 'bag.update' | t }}</button>
        </noscript>
        <button
          type="submit"
          name="checkout"
          class="cart-drawer__checkout main-cart__checkout"
          data-checkout
          {% unless ready %}disabled aria-disabled="true"{% endunless %}
        >
          {{ 'bag.checkout' | t }}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </form>

    <script>
      (function () {
        var form = document.getElementById('MainCartForm')
        if (!form) return
        var updateButton = form.querySelector('[data-update]')
        var submitting = false
        function submit() {
          if (submitting) return
          submitting = true
          if (form.requestSubmit) form.requestSubmit(updateButton || undefined)
          else form.submit()
        }
        form.addEventListener('click', function (e) {
          var button = e.target.closest('[data-step]')
          if (!button || button.disabled) return
          var line = button.closest('[data-line]')
          var input = line && line.querySelector('input[data-qty]')
          if (!input) return
          input.value = Math.max(0, (parseInt(input.value, 10) || 0) + parseInt(button.dataset.step, 10))
          submit()
        })
        form.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' && e.target.matches('input[data-qty]')) {
            e.preventDefault()
            submit()
          }
        })
        form.addEventListener('change', function (e) {
          if (e.target.matches('input[data-qty]')) submit()
        })
      })()
    </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Your bag" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Your bag is empty." },
    { "type": "text", "id": "empty_cta_label", "label": "Empty button label", "default": "Start shopping" },
    { "type": "url", "id": "empty_cta_link", "label": "Empty button link", "default": "/collections/all" },
    { "type": "text", "id": "note_ready", "label": "Checkout note", "default": "Cash on delivery. Delivery charges are shown at checkout." }
  ]
}
{% endschema %}
