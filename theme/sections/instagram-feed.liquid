{{ 'component-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'component-arrow-button.css' | asset_url | stylesheet_tag }}
{{ 'section-instagram-feed.css' | asset_url | stylesheet_tag }}
<script src="{{ 'instagram-feed.js' | asset_url }}" defer></script>

{%- liquid
  # Mirrors components/home/InstagramFeed.tsx. Tiles rendered here are the
  # fallback / manual tiles (lib/instagram.ts FALLBACK_POSTS); instagram-feed.js
  # swaps in the live posts from feed_url when there are any.
  assign ig_profile = section.settings.profile_url | default: 'https://instagram.com'
  assign ig_limit = section.settings.limit | default: 12
  assign ig_feed = section.settings.feed_url | strip
  assign ig_sizes = '(min-width: 1200px) 17vw, (min-width: 810px) 25vw, 42vw'
-%}

<section
  class="instagram-feed"
  data-section="instagram"
  style="--instagram-glyph: url('{{ 'icon-instagram.svg' | asset_url }}');"
>
  {%- render 'section-heading',
    title: section.settings.heading,
    cta_label: section.settings.cta_label,
    cta_href: ig_profile
  -%}
  <instagram-feed
    {% if ig_feed != blank %}data-feed-url="{{ ig_feed | escape }}"{% endif %}
    data-limit="{{ ig_limit }}"
  >
    <ul class="instagram-feed__strip" data-strip>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign ig_href = block.settings.link | default: ig_profile
            assign ig_kind = block.settings.kind | default: 'image'
            assign ig_label = 'Post on Instagram'
            if ig_kind == 'video'
              assign ig_label = 'Reel on Instagram'
            endif
          -%}
          <li
            class="instagram-feed__tile"
            {% if block.settings.video_url != blank %}data-video="{{ block.settings.video_url | escape }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            <a
              class="instagram-feed__link"
              href="{{ ig_href }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="{{ ig_label }}"
            >
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 640 | image_tag:
                  class: 'instagram-feed__media',
                  alt: '',
                  loading: 'lazy',
                  decoding: 'async',
                  widths: '400, 640, 960',
                  sizes: ig_sizes
                }}
              {%- endif -%}
              {%- if ig_kind == 'video' -%}
                <span class="instagram-feed__badge">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="2.75" y="2.75" width="18.5" height="18.5" rx="5"/><path d="M2.75 8h18.5M8.5 2.75 11.5 8M14.5 2.75 17.5 8"/><path d="M10 11.25v6l5-3z" fill="currentColor"/></svg>
                </span>
              {%- elsif ig_kind == 'carousel' -%}
                <span class="instagram-feed__badge">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="7.75" y="2.75" width="13.5" height="13.5" rx="3"/><path d="M16.25 19.25a2 2 0 0 1-2 2H5.75a3 3 0 0 1-3-3V9.75a2 2 0 0 1 2-2"/></svg>
                </span>
              {%- endif -%}
              <span class="instagram-feed__hover" aria-hidden="true"><span class="instagram-feed__glyph"></span></span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign ig_slugs = 'look-street-ready|look-off-duty|wear-the-dream|look-daily-edit|look-brunch-dates|collections' | split: '|' -%}
        {%- assign ig_alts = 'Street ready look: black vinyl puffer with a two-stripe wide-leg trouser|Off duty look: olive cropped puffer with a cream high-waist jogger|Khuwabb campaign photo|Daily edit look: beige cropped puffer gilet over a black ribbed trouser|Brunch dates look: maroon boat-neck maxi dress|Khuwabb pieces on a clothes rail' | split: '|' -%}
        {%- for ig_slug in ig_slugs -%}
          {%- liquid
            assign ig_src = ig_slug | append: '-640w.webp' | asset_url
            case ig_slug
              when 'wear-the-dream'
                assign ig_srcset = ig_slug | append: '-640w.webp' | asset_url | append: ' 640w, ' | append: ig_slug | append: '-960w.webp' | asset_url | append: ' 960w, ' | append: ig_slug | append: '-1280w.webp' | asset_url | append: ' 1280w'
              when 'collections'
                assign ig_srcset = ig_slug | append: '-640w.webp' | asset_url | append: ' 640w, ' | append: ig_slug | append: '-960w.webp' | asset_url | append: ' 960w, ' | append: ig_slug | append: '-1280w.webp' | asset_url | append: ' 1280w'
              else
                assign ig_srcset = ig_slug | append: '-400w.webp' | asset_url | append: ' 400w, ' | append: ig_slug | append: '-640w.webp' | asset_url | append: ' 640w, ' | append: ig_slug | append: '-960w.webp' | asset_url | append: ' 960w'
            endcase
          -%}
          <li class="instagram-feed__tile">
            <a
              class="instagram-feed__link"
              href="{{ ig_profile }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Post on Instagram: {{ ig_alts[forloop.index0] | escape }}"
            >
              <img
                class="instagram-feed__media"
                src="{{ ig_src }}"
                srcset="{{ ig_srcset }}"
                sizes="{{ ig_sizes }}"
                width="640"
                height="1138"
                alt=""
                loading="lazy"
                decoding="async"
              >
              <span class="instagram-feed__hover" aria-hidden="true"><span class="instagram-feed__glyph"></span></span>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </instagram-feed>
</section>

{% schema %}
{
  "name": "Instagram feed",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the dream" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Follow on Instagram" },
    { "type": "url", "id": "profile_url", "label": "Instagram profile link", "info": "The brand's Instagram profile link. The button and the fallback tiles open it." },
    { "type": "text", "id": "feed_url", "label": "Live feed URL", "default": "https://khuwabb-export-factory-leftovers.vercel.app/api/instagram", "info": "Paste a Behold.so JSON feed link (behold.so → your feed → JSON) or the headless site's /api/instagram link. Clear it to only show the manual tiles below." },
    { "type": "range", "id": "limit", "label": "Live posts", "min": 6, "max": 12, "step": 1, "default": 12 }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "9:16 works best. Also the cover frame for a reel." },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the profile link." },
        {
          "type": "select",
          "id": "kind",
          "label": "Type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Reel" },
            { "value": "carousel", "label": "Carousel" }
          ],
          "default": "image"
        },
        { "type": "text", "id": "video_url", "label": "Reel video URL (optional)", "info": "Direct .mp4 link. Plays muted while on screen." }
      ]
    }
  ],
  "presets": [{ "name": "Instagram feed" }]
}
{% endschema %}
