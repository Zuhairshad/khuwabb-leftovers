{{ 'component-form.css' | asset_url | stylesheet_tag }}
{{ 'section-customer.css' | asset_url | stylesheet_tag }}

<div class="page-width">
  <div class="customer customer--form" data-section="main-reset-password">
    <h1 class="customer__title">{{ 'customer.reset.title' | t }}</h1>

    {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" id="ResetErrors" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.reset.password' | t }}</label>
        <input
          class="field__input"
          type="password"
          id="ResetPassword"
          name="customer[password]"
          autocomplete="new-password"
          required
          {% if form.errors %}
            aria-invalid="true" aria-describedby="ResetErrors"
          {% endif %}
        >
      </div>

      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset.password_confirm' | t }}</label>
        <input
          class="field__input"
          type="password"
          id="ResetPasswordConfirm"
          name="customer[password_confirmation]"
          autocomplete="new-password"
          required
          {% if form.errors %}
            aria-invalid="true" aria-describedby="ResetErrors"
          {% endif %}
        >
      </div>

      <button type="submit" class="button button--full">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password"
}
{% endschema %}
