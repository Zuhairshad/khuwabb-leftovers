{{ 'component-form.css' | asset_url | stylesheet_tag }}
{{ 'section-customer.css' | asset_url | stylesheet_tag }}

<div class="page-width">
  <div class="customer customer--wide" data-section="main-account">
    <div class="customer__header">
      <h1 class="customer__title">{{ 'customer.account.title' | t }}</h1>
      <a class="button button--secondary button--small" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
    </div>

    <div class="account__grid">
      <div class="account__orders">
        <h2 class="customer__heading">{{ 'customer.account.orders' | t }}</h2>

        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="orders">
              <thead>
                <tr>
                  <th scope="col">{{ 'customer.account.order' | t }}</th>
                  <th scope="col">{{ 'customer.account.date' | t }}</th>
                  <th scope="col">{{ 'customer.account.payment' | t }}</th>
                  <th scope="col">{{ 'customer.account.fulfillment' | t }}</th>
                  <th scope="col" class="orders__num">{{ 'customer.account.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td data-label="{{ 'customer.account.order' | t }}">
                      <a class="orders__link" href="{{ order.customer_url }}">{{ order.name }}</a>
                    </td>
                    <td data-label="{{ 'customer.account.date' | t }}">{{ order.created_at | time_tag: '%-d %B %Y' }}</td>
                    <td data-label="{{ 'customer.account.payment' | t }}">{{ order.financial_status_label }}</td>
                    <td data-label="{{ 'customer.account.fulfillment' | t }}">{{ order.fulfillment_status_label }}</td>
                    <td data-label="{{ 'customer.account.total' | t }}" class="orders__num">{% render 'price', price: order.total_price %}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>

            {%- if paginate.pages > 1 -%}
              <nav class="customer__pagination" aria-label="{{ 'general.pagination.page' | t: number: paginate.current_page }}">
                {%- if paginate.previous -%}
                  <a class="customer__page" href="{{ paginate.previous.url }}" rel="prev">{{ 'general.pagination.previous' | t }}</a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a class="customer__page" href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
                  {%- elsif part.title == paginate.current_page -%}
                    <span class="customer__page" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="customer__page">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a class="customer__page" href="{{ paginate.next.url }}" rel="next">{{ 'general.pagination.next' | t }}</a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- else -%}
            <p class="account__empty">{{ 'customer.account.no_orders' | t }}</p>
            <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'bag.start_shopping' | t }}</a>
          {%- endif -%}
        {%- endpaginate -%}
      </div>

      <aside class="account__card">
        <h2 class="customer__heading">{{ 'customer.account.details' | t }}</h2>
        <p><strong>{{ customer.name }}</strong></p>
        <p>{{ customer.email }}</p>
        {%- if customer.default_address != blank -%}
          <div class="account__address">
            {{ customer.default_address | format_address }}
          </div>
        {%- endif -%}
        <p>
          <a class="customer__link" href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t: count: customer.addresses_count }}</a>
        </p>
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Account"
}
{% endschema %}
