{%- comment -%}
  "Shop the look": sticky stacking outfit cards (components/home/Looks.tsx). See docs/parity/shop-the-look.md.

  - CSS-only stacking (position: sticky; top: 96px). No ancestor in this section sets overflow (sticky would break);
    only the card itself and its photo use overflow: clip, as in the source.
  - Photo: block `image` when set, else the theme-asset fallback chosen by `fallback_image` (400/640/960w WebPs).
  - Piece rows come from product_1..3 + colour_1..3; slots whose product is blank are skipped.
  - Total = sum of product.price, shown only when no slot has a colour but a missing product, and at least one piece exists.
  - The source's data-look slug is not a setting here: data-look carries block.id.
{%- endcomment -%}
{{ 'component-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'component-arrow-button.css' | asset_url | stylesheet_tag }}
{{ 'component-product-price.css' | asset_url | stylesheet_tag }}
{{ 'section-shop-the-look.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign stl_sizes = '(max-width: 809px) calc(100vw - 72px), (max-width: 1199px) 320px, 470px'
  assign stl_cta = section.settings.cta_label | default: 'Shop all'
  assign stl_link = section.settings.cta_link | default: routes.all_products_collection_url
  assign stl_heading = section.settings.heading | default: 'Shop the look'
  assign stl_total_label = section.settings.total_label | default: 'The look'
-%}

<section id="looks" class="shop-the-look" data-section="looks">
  {% render 'section-heading', title: stl_heading %}
  <div class="shop-the-look__list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign b_tint = b.tint | default: '#c9d2f2'
        assign b_fallback = b.fallback_image
        assign p_count = 0
        assign p_total = 0
        assign p_missing = false
        for n in (1..3)
          case n
            when 1
              assign cur_p = b.product_1
              assign cur_c = b.colour_1
            when 2
              assign cur_p = b.product_2
              assign cur_c = b.colour_2
            else
              assign cur_p = b.product_3
              assign cur_c = b.colour_3
          endcase
          if cur_p
            assign p_count = p_count | plus: 1
            assign p_total = p_total | plus: cur_p.price
          elsif cur_c != blank
            assign p_missing = true
          endif
        endfor
      -%}
      <article class="shop-the-look__look" style="background: {{ b_tint }};" data-look="{{ block.id }}" {{ block.shopify_attributes }}>
        <div class="shop-the-look__photo">
          {%- if b.image != blank -%}
            {{
              b.image
              | image_url: width: 960
              | image_tag:
                widths: '400, 640, 960',
                sizes: stl_sizes,
                loading: 'lazy',
                decoding: 'async',
                alt: b.image_alt,
                class: 'shop-the-look__photo-img'
            }}
          {%- elsif b_fallback != blank and b_fallback != 'none' -%}
            {%- liquid
              assign fb_400 = 'look-' | append: b_fallback | append: '-400w.webp'
              assign fb_640 = 'look-' | append: b_fallback | append: '-640w.webp'
              assign fb_960 = 'look-' | append: b_fallback | append: '-960w.webp'
            -%}
            <img
              class="shop-the-look__photo-img"
              src="{{ fb_960 | asset_url }}"
              srcset="{{ fb_400 | asset_url }} 400w, {{ fb_640 | asset_url }} 640w, {{ fb_960 | asset_url }} 960w"
              sizes="{{ stl_sizes }}"
              width="960"
              height="1200"
              alt="{{ b.image_alt | escape }}"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </div>
        <div class="shop-the-look__details">
          <div class="shop-the-look__intro">
            <h2 class="shop-the-look__name">{{ b.title }}</h2>
            <p class="shop-the-look__description">{{ b.description }}</p>
          </div>
          <div class="shop-the-look__pieces">
            {%- for n in (1..3) -%}
              {%- liquid
                case n
                  when 1
                    assign cur_p = b.product_1
                    assign cur_c = b.colour_1
                  when 2
                    assign cur_p = b.product_2
                    assign cur_c = b.colour_2
                  else
                    assign cur_p = b.product_3
                    assign cur_c = b.colour_3
                endcase
              -%}
              {%- if cur_p -%}
                {%- liquid
                  assign piece_href = cur_p.url
                  if cur_c != blank
                    assign piece_colour_enc = cur_c | url_encode
                    assign piece_href = cur_p.url | append: '?colour=' | append: piece_colour_enc
                  endif
                  # Lowest-priced variant's compare-at (lib/catalog.ts shopifyPrices).
                  assign piece_compare_variant = cur_p.variants | where: 'price', cur_p.price_min | first
                  assign piece_compare_at = piece_compare_variant.compare_at_price
                -%}
                <a href="{{ piece_href }}" class="shop-the-look__piece">
                  <div class="shop-the-look__thumb">
                    {%- render 'cutout-image',
                      product: cur_p,
                      colour: cur_c,
                      view: 'front',
                      widths: '120,240,360',
                      sizes: '60px',
                      loading: 'lazy',
                      decorative: true
                    -%}
                  </div>
                  <div class="shop-the-look__text">
                    <p class="shop-the-look__piece-name">{{ cur_p.title }}</p>
                    {%- if cur_c != blank -%}
                      <p class="shop-the-look__colour">{{ cur_c }}</p>
                    {%- endif -%}
                  </div>
                  <p class="shop-the-look__price">{% render 'product-price', price: cur_p.price, compare_at: piece_compare_at %}</p>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="shop-the-look__actions">
            {% render 'arrow-button', href: stl_link, label: stl_cta %}
            {%- if p_count > 0 and p_missing == false -%}
              <p class="shop-the-look__total">{{ stl_total_label }} · {% render 'price', price: p_total %}</p>
            {%- endif -%}
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop the look",
  "class": "section-shop-the-look",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "cta_link", "label": "Button link", "default": "/collections/all" },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "The look" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Daily edit" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A cropped puffer gilet over the ribbed drawstring trouser. Easy layers for every day." },
        { "type": "color", "id": "tint", "label": "Card tint", "default": "#c9d2f2" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Leave blank to use the built-in photo chosen below." },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Built-in photo (used when no photo is uploaded)",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "daily-edit", "label": "Daily edit" },
            { "value": "off-duty", "label": "Off duty" },
            { "value": "street-ready", "label": "Street ready" },
            { "value": "brunch-dates", "label": "Brunch dates" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "image_alt", "label": "Photo alt text" },
        { "type": "product", "id": "product_1", "label": "Piece 1", "info": "Pick after adding the section. Presets can't include products/collections." },
        { "type": "text", "id": "colour_1", "label": "Piece 1 colour" },
        { "type": "product", "id": "product_2", "label": "Piece 2", "info": "Pick after adding the section. Presets can't include products/collections." },
        { "type": "text", "id": "colour_2", "label": "Piece 2 colour" },
        { "type": "product", "id": "product_3", "label": "Piece 3", "info": "Pick after adding the section. Presets can't include products/collections." },
        { "type": "text", "id": "colour_3", "label": "Piece 3 colour" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        { "type": "look", "settings": { "title": "Daily edit", "description": "A cropped puffer gilet over the ribbed drawstring trouser. Easy layers for every day.", "tint": "#c9d2f2", "fallback_image": "daily-edit", "image_alt": "The Daily edit look: Hooded Sleeveless Cropped Puffer Jacket in Beige with Ribbed Drawstring Wide Leg Trouser in Black", "colour_1": "Beige", "colour_2": "Black" } },
        { "type": "look", "settings": { "title": "Off duty", "description": "The olive cropped puffer with our cream high-waist jogger. Soft, warm and weekend-ready.", "tint": "#f6c9cf", "fallback_image": "off-duty", "image_alt": "The Off duty look: Hooded Full Sleeve Cropped Puffer Jacket in Olive with Shape High Waist Wide Leg Jogger in Cream", "colour_1": "Olive", "colour_2": "Cream" } },
        { "type": "look", "settings": { "title": "Street ready", "description": "High shine meets sporty stripes: the black vinyl puffer with the two-stripe wide-leg trouser.", "tint": "#d5e5be", "fallback_image": "street-ready", "image_alt": "The Street ready look: Ladies Vinyl Jacket in Black with Wide Leg Trouser with Two Full Stripes in Blue", "colour_1": "Black", "colour_2": "Blue" } },
        { "type": "look", "settings": { "title": "Brunch dates", "description": "The boat-neck maxi in maroon: sleek, long-sleeved and made for long lunches.", "tint": "#f5e7a6", "fallback_image": "brunch-dates", "image_alt": "The Brunch dates look: Boat Neck Long Sleeve Maxi Dress in Maroon", "colour_1": "Maroon" } }
      ]
    }
  ]
}
{% endschema %}
