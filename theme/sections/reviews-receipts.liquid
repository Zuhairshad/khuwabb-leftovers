{{ 'section-reviews-receipts.css' | asset_url | stylesheet_tag }}
<script src="{{ 'receipts.js' | asset_url }}" defer></script>

{%- liquid
  assign rr_brand = section.settings.brand
  assign rr_drag = section.settings.draggable
  assign rr_star = 'M 9.749 15.477 L 14.879 18.632 C 15.151 18.797 15.496 18.782 15.753 18.594 C 16.01 18.406 16.128 18.082 16.053 17.772 L 14.658 11.886 L 19.223 7.948 C 19.461 7.739 19.552 7.409 19.455 7.108 C 19.357 6.806 19.09 6.592 18.774 6.563 L 12.783 6.075 L 10.475 0.488 C 10.354 0.193 10.068 0 9.749 0 C 9.431 0 9.144 0.193 9.023 0.488 L 6.715 6.075 L 0.724 6.563 C 0.406 6.59 0.136 6.806 0.038 7.109 C -0.06 7.412 0.034 7.745 0.275 7.953 L 4.84 11.89 L 3.445 17.772 C 3.37 18.082 3.488 18.406 3.745 18.594 C 4.002 18.782 4.347 18.797 4.619 18.632 Z'
-%}
<section class="reviews-receipts" data-section="receipts">
  {%- if section.settings.heading != blank -%}
    <h2 class="reviews-receipts__title" data-appear="rise">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="reviews-receipts__row">
    {%- for block in section.blocks -%}
      {%- liquid
        assign rr_delay = forloop.index0 | times: 0.18 | plus: 0.15 | round: 2
        assign rr_tilt = block.settings.tilt | default: 0
        assign rr_total = 0
        assign rr_p1 = block.settings.product_1
        assign rr_p2 = block.settings.product_2
        if rr_p1 != blank
          assign rr_total = rr_total | plus: rr_p1.price
        endif
        if rr_p2 != blank
          assign rr_total = rr_total | plus: rr_p2.price
        endif
        if rr_drag
          assign rr_tag = 'receipt-drag'
        else
          assign rr_tag = 'div'
        endif
      -%}
      <{{ rr_tag }} class="reviews-receipts__slot" {{ block.shopify_attributes }}>
        <div
          class="reviews-receipts__receipt"
          data-appear="receipt"
          data-appear-amount="0.25"
          style="--tilt: {{ rr_tilt }}deg; --delay: {{ rr_delay }}s;"
        >
          <div class="reviews-receipts__paper">
            <div class="reviews-receipts__head">
              <p class="reviews-receipts__brand">{{ rr_brand | escape }}</p>
              <p class="reviews-receipts__order">{{ block.settings.order_text | escape }}</p>
            </div>
            <div class="reviews-receipts__dash"></div>
            {%- for rr_p in (1..2) -%}
              {%- liquid
                if rr_p == 1
                  assign rr_line = rr_p1
                else
                  assign rr_line = rr_p2
                endif
              -%}
              {%- if rr_line != blank -%}
                <div class="reviews-receipts__line">
                  <p class="reviews-receipts__line-name">{{ rr_line.title | escape }}</p>
                  <p>{% render 'price', price: rr_line.price %}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
            <div class="reviews-receipts__dash"></div>
            <div class="reviews-receipts__line reviews-receipts__total">
              <p class="reviews-receipts__line-name">{{ 'receipts.total' | t }}</p>
              <p>{% render 'price', price: rr_total %}</p>
            </div>
            <div class="reviews-receipts__dash"></div>
            <div class="reviews-receipts__stars" role="img" aria-label="{{ 'accessibility.stars' | t }}">
              {%- for rr_s in (1..5) -%}
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="{{ rr_star }}" transform="translate(2.251 2.25)" fill="#17140f" stroke="#17140f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endfor -%}
            </div>
            <p class="reviews-receipts__quote">{{ block.settings.quote | escape }}</p>
            <p class="reviews-receipts__by">{{ block.settings.byline | escape }}</p>
          </div>
          <svg class="reviews-receipts__tear" viewBox="0 0 340 14" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 0H340V2 L330 14 L320 2 L310 14 L300 2 L290 14 L280 2 L270 14 L260 2 L250 14 L240 2 L230 14 L220 2 L210 14 L200 2 L190 14 L180 2 L170 14 L160 2 L150 14 L140 2 L130 14 L120 2 L110 14 L100 2 L90 14 L80 2 L70 14 L60 2 L50 14 L40 2 L30 14 L20 2 L10 14 L0 2 Z" fill="#FFFFFF"/>
          </svg>
        </div>
      </{{ rr_tag }}>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews (receipts)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seen on you" },
    { "type": "text", "id": "brand", "label": "Receipt brand", "default": "khuwabb" },
    { "type": "checkbox", "id": "draggable", "label": "Receipts can be dragged and thrown", "default": true }
  ],
  "blocks": [
    {
      "type": "receipt",
      "name": "Receipt",
      "limit": 6,
      "settings": [
        { "type": "paragraph", "content": "The default reviews are DRAFT placeholders written for the layout. Replace them with genuine customer reviews before launch." },
        { "type": "text", "id": "order_text", "label": "Order text", "default": "Order KH-1042 · 14 Oct 2026" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "“The co-ord is so comfortable I wore it to class three days running. Cash on delivery made it easy too.”" },
        { "type": "text", "id": "byline", "label": "Byline", "default": "Ayesha, Lahore" },
        { "type": "range", "id": "tilt", "label": "Tilt (degrees)", "min": -5, "max": 5, "step": 0.5, "default": -3 },
        { "type": "product", "id": "product_1", "label": "Product 1", "info": "Pick after adding the section. Presets can't include products/collections." },
        { "type": "product", "id": "product_2", "label": "Product 2", "info": "Pick after adding the section. Presets can't include products/collections." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Reviews (receipts)",
      "blocks": [
        { "type": "receipt" },
        {
          "type": "receipt",
          "settings": {
            "order_text": "Order KH-1107 · 29 Oct 2026",
            "quote": "“Exchanged a size within the week, no fuss. The jogger is the comfiest thing I own.”",
            "byline": "Hamza, Karachi",
            "tilt": 2
          }
        },
        {
          "type": "receipt",
          "settings": {
            "order_text": "Order KH-1163 · 6 Nov 2026",
            "quote": "“The puffer is warm without being bulky, and the striped trousers get compliments every time.”",
            "byline": "Mahnoor, Islamabad",
            "tilt": -1.5
          }
        }
      ]
    }
  ]
}
{% endschema %}
