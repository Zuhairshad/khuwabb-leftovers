{%- comment -%}
  Password page (Shopify-only, no React reference; docs/parity/password-gift-card.md).
  Rendered inside layout/password.liquid. Newsletter: an equivalent light-variant
  {% form 'customer' %} built here (the footer snippet is dark-themed and reads
  footer-only settings, and footer.js is not loaded in the password layout), so
  state is server-driven only (posted_successfully / errors).
{%- endcomment -%}
{{ 'component-form.css' | asset_url | stylesheet_tag }}
{{ 'section-password.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.title != blank
    assign title = section.settings.title
  else
    assign title = 'general.password_page.opening_soon' | t
  endif
  assign message = section.settings.message
  if message == blank
    assign message = shop.password_message
  endif
  assign placeholder = section.settings.newsletter_placeholder | default: 'Your email'
  assign button_label = section.settings.newsletter_button | default: 'Notify me'
  assign success_text = section.settings.newsletter_success | default: 'You’re in. See you in your inbox.'
  assign error_text = section.settings.newsletter_error | default: 'That email doesn’t look right'
-%}

<div class="password-page" data-section="password" data-section-id="{{ section.id }}">
  {%- if section.settings.show_arches -%}
    <div class="password-page__arches" aria-hidden="true">
      <span style="--arch-colour: var(--pistachio)"></span>
      <span style="--arch-colour: var(--strawberry)"></span>
      <span style="--arch-colour: var(--lemon)"></span>
      <span style="--arch-colour: var(--blueberry)"></span>
      <span style="--arch-colour: var(--peach)"></span>
    </div>
  {%- endif -%}

  <div class="password-page__inner">
    <div class="password-page__logo">
      <img src="{{ 'logo.png' | asset_url }}" alt="" width="365" height="256">
      <span>{{ section.settings.logo_label | escape }}</span>
    </div>

    <div class="password-page__content">
      <h1 class="password-page__title">{{ title | escape }}</h1>
      {%- if message != blank -%}
        <div class="password-page__message rte">{{ message }}</div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        {%- form 'customer', id: 'PasswordNewsletter', class: 'password-page__newsletter', novalidate: 'novalidate' -%}
          {%- liquid
            assign state = 'idle'
            if form.posted_successfully?
              assign state = 'done'
            elsif form.errors
              assign state = 'bad'
            endif
          -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="password-page__pill" data-state="{{ state }}">
            <input
              class="password-page__pill-input"
              type="email"
              name="contact[email]"
              required
              autocomplete="email"
              aria-label="{{ 'newsletter.label' | t }}"
              placeholder="{{ placeholder | escape }}"
              value="{{ form.email }}"
              {% if state == 'bad' %}
                aria-invalid="true"
              {% endif %}
              {% if state == 'done' %}
                disabled
              {% endif %}
            >
            <button class="password-page__pill-button" type="submit" {% if state == 'done' %}disabled{% endif %}>{{ button_label | escape }}</button>
          </div>
          {%- if state == 'done' -%}
            <p class="form-message form-message--success" role="status">{{ success_text | escape }}</p>
          {%- elsif state == 'bad' -%}
            <p class="form-message form-message--error" role="alert">{{ error_text | escape }}</p>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}

      {%- form 'storefront_password', class: 'password-page__login-form' -%}
        <details class="password-page__login" {% if form.errors %}open{% endif %}>
          <summary class="password-page__login-summary">{{ 'general.password_page.login_label' | t }}</summary>
          <div class="password-page__login-body">
            {%- if form.errors -%}
              <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <div class="field">
              <label class="field__label" for="PasswordInput-{{ section.id }}">{{ 'general.password_page.password' | t }}</label>
              <input
                class="field__input"
                type="password"
                name="password"
                id="PasswordInput-{{ section.id }}"
                autocomplete="current-password"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  autofocus
                {% endif %}
              >
            </div>
            <button class="button button--full" type="submit">{{ 'general.password_page.submit' | t }}</button>
          </div>
        </details>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "logo_label", "label": "Text under the logo", "default": "leftover" },
    { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use \"Opening soon\"." },
    { "type": "richtext", "id": "message", "label": "Message", "info": "Leave blank to use the message from Preferences > Password protection." },
    { "type": "checkbox", "id": "show_arches", "label": "Show pastel arches", "default": true },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email sign-up", "default": true },
    { "type": "text", "id": "newsletter_placeholder", "label": "Placeholder", "default": "Your email" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "newsletter_success", "label": "Success message", "default": "You’re in. See you in your inbox." },
    { "type": "text", "id": "newsletter_error", "label": "Error message", "default": "That email doesn’t look right" }
  ]
}
{% endschema %}
