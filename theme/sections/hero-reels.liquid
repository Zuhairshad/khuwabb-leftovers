{%- comment -%}
  Home hero: outfit reels (components/home/Hero.tsx + components/ScoopReels.tsx).
  Liquid builds the reels' pieces (tops = jackets x colours, bottoms = trousers x colours, plus the set
  product's piece-top / piece-bottom), the server-rendered DOM and a JSON payload (docs/mapping.md 3.4).
  assets/hero-reels.js (<hero-reels>, <look-chooser>) runs the engine.
  Parity table: docs/parity/hero-reels.md.

  Piece records are strings while building (fields joined by ~~, records by ^^):
  id ~~ handle ~~ name ~~ price ~~ src ~~ srcset ~~ width ~~ height ~~ fit ~~ media id

  Garment fit (ScoopReels.tsx:14, 207-212, 218-246, 257-269): the reference carries a per-piece
  `fit: "any" | "men" | "women"` used by the look's drag/shuffle "pull the other rows onto a
  matching fit" logic. Khuwabb is a women's-only catalogue with no men's/women's split, so Hero.tsx
  (the reference's data source) hardcodes `fit: "any"` on every piece it builds - the fit machinery
  is ported in full (below + hero-reels.js) but is inert with today's catalogue, exactly like the
  reference. `hr_fit` reads an optional `fit:men` / `fit:women` product tag so the mechanism is
  live the moment such a tag exists; no product has one today, so output is unchanged (parity).
{%- endcomment -%}
{%- render 'section-hero-reels-styles' -%}
<script src="{{ 'hero-reels.js' | asset_url }}" async fetchpriority="high"></script>

{%- liquid
  assign hr_set = section.settings.set_product
  assign hr_widths = '300,360,420,480,540,640' | split: ','
  assign hr_rows = 'tops,bottoms' | split: ','
  assign hr_rendered = '|'
  assign hr_need = '|'
  assign hr_products_json = ''
  assign hr_tops = ''
  assign hr_bottoms = ''

  for hr_row in hr_rows
    if hr_row == 'tops'
      assign hr_coll = section.settings.tops_collection
      assign hr_set_view = 'piece-top'
    else
      assign hr_coll = section.settings.bottoms_collection
      assign hr_set_view = 'piece-bottom'
    endif
    assign hr_coll_products = hr_coll.products
    assign hr_count = hr_coll_products | size
    assign hr_last = hr_count | minus: 1
    if hr_set != blank
      assign hr_last = hr_count
    endif

    assign hr_groups = ''
    assign hr_max = 0

    for hr_i in (0..hr_last)
      if hr_i < hr_count
        assign hr_p = hr_coll_products[hr_i]
        assign hr_view = 'front'
      else
        assign hr_p = hr_set
        assign hr_view = hr_set_view
      endif

      assign hr_opt = hr_p.options_by_name['Color']
      if hr_opt
        assign hr_ci = hr_opt.position | minus: 1
        assign hr_names = hr_opt.values
      else
        assign hr_ci = -1
        assign hr_names = 'Default' | split: ','
      endif

      comment
        Garment fit (ScoopReels.tsx:14): optional "fit:men" / "fit:women" product tag, else "any"
        (the reference's current default for every piece - see the comment at the top of this file).
      endcomment
      assign hr_fit = 'any'
      for hr_tag in hr_p.tags
        assign hr_tag_norm = hr_tag | strip | downcase
        if hr_tag_norm == 'fit:men' or hr_tag_norm == 'fit:man'
          assign hr_fit = 'men'
        elsif hr_tag_norm == 'fit:women' or hr_tag_norm == 'fit:woman'
          assign hr_fit = 'women'
        endif
      endfor

      assign hr_group = ''
      assign hr_group_size = 0
      for hr_name in hr_names
        assign hr_norm = hr_name | strip | downcase
        assign hr_media = nil
        for hr_m in hr_p.media
          if hr_m.media_type != 'image'
            continue
          endif
          assign hr_parts = hr_m.alt | split: '|'
          if hr_parts.size < 2
            continue
          endif
          assign hr_a = hr_parts[0] | strip | downcase
          assign hr_b = hr_parts[1] | strip | downcase
          if hr_a == hr_norm and hr_b == hr_view
            assign hr_media = hr_m
            break
          endif
        endfor

        comment
          A colour without an explicit front cut-out falls back to its variant's featured media
          (the convention makes that the front); set pieces need the exact piece-top / piece-bottom alt.
        endcomment
        if hr_media == nil and hr_view == 'front'
          for hr_v in hr_p.variants
            if hr_v.featured_media == nil
              continue
            endif
            if hr_ci >= 0
              assign hr_vc = hr_v.options[hr_ci] | strip | downcase
              if hr_vc != hr_norm
                continue
              endif
            endif
            assign hr_media = hr_v.featured_media
            break
          endfor
        endif

        if hr_media != nil
          assign hr_pw = hr_media.preview_image.width
          assign hr_ph = hr_media.preview_image.height
          assign hr_srcset = ''
          assign hr_top_w = 0
          assign hr_top_u = ''
          for hr_w in hr_widths
            assign hr_wi = hr_w | strip | plus: 0
            if hr_wi <= hr_pw
              assign hr_u = hr_media | image_url: width: hr_wi
              assign hr_piece = hr_u | append: ' ' | append: hr_wi | append: 'w'
              if hr_srcset == ''
                assign hr_srcset = hr_piece
              else
                assign hr_srcset = hr_srcset | append: ', ' | append: hr_piece
              endif
              assign hr_top_w = hr_wi
              assign hr_top_u = hr_u
            endif
          endfor
          if hr_top_w == 0
            assign hr_top_w = hr_pw
            assign hr_top_u = hr_media | image_url: width: hr_pw
            assign hr_srcset = hr_top_u | append: ' ' | append: hr_pw | append: 'w'
          endif
          assign hr_th = hr_top_w | times: hr_ph | plus: 0.0 | divided_by: hr_pw | round

          assign hr_rec = hr_p.handle | append: '#' | append: hr_name | append: '~~' | append: hr_p.handle | append: '~~' | append: hr_p.title | append: '~~' | append: hr_p.price | append: '~~' | append: hr_top_u | append: '~~' | append: hr_srcset | append: '~~' | append: hr_top_w | append: '~~' | append: hr_th | append: '~~' | append: hr_fit | append: '~~' | append: hr_media.id
          assign hr_group = hr_group | append: hr_rec | append: '^^'
          assign hr_group_size = hr_group_size | plus: 1

          if hr_view != 'front'
            break
          endif
        endif
      endfor

      if hr_group_size > 0
        assign hr_groups = hr_groups | append: hr_group | append: '%%'
        if hr_group_size > hr_max
          assign hr_max = hr_group_size
        endif
        assign hr_key = '|' | append: hr_p.handle | append: '|'
        unless hr_rendered contains hr_key
          assign hr_rendered = hr_rendered | append: hr_p.handle | append: '|'
          comment
            Compact chooser record (title, url, price, colour names, sizes, variants). The shared product-json
            snippet also carries every colour's image URLs, which the chooser never reads.
          endcomment
          assign hr_si = -1
          assign hr_sopt = hr_p.options_by_name['Size']
          if hr_sopt
            assign hr_si = hr_sopt.position | minus: 1
          endif
          capture hr_pj
            echo '{"title":'
            echo hr_p.title | json
            echo ',"url":'
            echo hr_p.url | json
            echo ',"price":' | append: hr_p.price | append: ',"colours":['
            for hr_cn in hr_names
              echo '{"name":'
              echo hr_cn | json
              echo '}'
              unless forloop.last
                echo ','
              endunless
            endfor
            echo '],"sizes":['
            if hr_sopt
              for hr_sv in hr_sopt.values
                echo hr_sv | json
                unless forloop.last
                  echo ','
                endunless
              endfor
            endif
            echo '],"variants":{'
            for hr_v in hr_p.variants
              if hr_ci >= 0
                assign hr_vcn = hr_v.options[hr_ci]
              else
                assign hr_vcn = 'Default'
              endif
              if hr_si >= 0
                assign hr_vsn = hr_v.options[hr_si]
              else
                assign hr_vsn = 'Default'
              endif
              echo hr_vcn | append: ' / ' | append: hr_vsn | json
              echo ':{"id":' | append: hr_v.id | append: ',"available":' | append: hr_v.available | append: '}'
              unless forloop.last
                echo ','
              endunless
            endfor
            echo '}}'
          endcapture
          if hr_products_json != ''
            assign hr_products_json = hr_products_json | append: ','
          endif
          assign hr_products_json = hr_products_json | append: '"' | append: hr_p.handle | append: '":' | append: hr_pj
        endunless
      endif
    endfor

    comment
      interleave(groups): round-robin across products
    endcomment
    assign hr_group_arr = hr_groups | split: '%%'
    assign hr_inter = ''
    if hr_max > 0
      assign hr_max_idx = hr_max | minus: 1
      for hr_k in (0..hr_max_idx)
        for hr_g in hr_group_arr
          assign hr_recs = hr_g | split: '^^'
          if hr_k < hr_recs.size
            assign hr_inter = hr_inter | append: hr_recs[hr_k] | append: '^^'
          endif
        endfor
      endfor
    endif

    comment
      fill(): lists of 2+ cycle round the ring up to 12 slots
    endcomment
    assign hr_il = hr_inter | split: '^^'
    assign hr_sz = hr_il.size
    assign hr_final = hr_inter
    if hr_sz >= 2
      assign hr_len = hr_sz
      if hr_len < 12
        assign hr_len = 12
      endif
      assign hr_len_idx = hr_len | minus: 1
      assign hr_final = ''
      for hr_j in (0..hr_len_idx)
        assign hr_ix = hr_j | modulo: hr_sz
        assign hr_final = hr_final | append: hr_il[hr_ix] | append: '^^'
      endfor
    endif

    if hr_row == 'tops'
      assign hr_tops = hr_final
    else
      assign hr_bottoms = hr_final
    endif
  endfor

  assign hr_tops_arr = hr_tops | split: '^^'
  assign hr_bottoms_arr = hr_bottoms | split: '^^'
  assign hr_has_pieces = false
  if hr_tops_arr.size > 0 or hr_bottoms_arr.size > 0
    assign hr_has_pieces = true
  endif

  comment
    Shuffle needs at least one row with 2+ distinct piece ids.
  endcomment
  assign hr_can_shuffle = false
  for hr_row in hr_rows
    if hr_row == 'tops'
      assign hr_arr = hr_tops_arr
    else
      assign hr_arr = hr_bottoms_arr
    endif
    assign hr_seen = '|'
    assign hr_distinct = 0
    for hr_rec in hr_arr
      assign hr_f = hr_rec | split: '~~'
      assign hr_id_key = '|' | append: hr_f[0] | append: '|'
      unless hr_seen contains hr_id_key
        assign hr_seen = hr_seen | append: hr_f[0] | append: '|'
        assign hr_distinct = hr_distinct | plus: 1
      endunless
    endfor
    if hr_distinct > 1
      assign hr_can_shuffle = true
    endif
  endfor

  comment
    Server-rendered first state: centre piece 0 of each row, "The look" total counts a shared id once.
  endcomment
  assign hr_tf = hr_tops_arr[0] | split: '~~'
  assign hr_bf = hr_bottoms_arr[0] | split: '~~'
  assign hr_total = 0
  if hr_tops_arr.size > 0
    assign hr_total = hr_tf[3] | plus: 0
  endif
  if hr_bottoms_arr.size > 0
    if hr_tops_arr.size == 0 or hr_bf[0] != hr_tf[0]
      assign hr_total = hr_total | plus: hr_bf[3]
    endif
  endif

  assign hr_intro = section.settings.intro

  comment
    Desktop piece widths are height-bound, not just 30vw / 26vw (hero-reels.js rowLayout): tops w = 0.92 * 0.44 * look,
    bottoms w = 0.7 * 0.51 * look, look = (hero height - top space - 112px bar) * look_scale. The hero is
    max(100vh, 720px) tall, and top = max(11% of height, top_space) >= top_space, so this never underestimates.
    The 0.46 / 0.36 vw phone widths are width-bound (the height cap is larger there), so those stay.
  endcomment
  assign hr_desk_top = section.settings.top_space | plus: 112
  assign hr_f_tops = section.settings.look_scale | times: 0.4048 | round: 4
  assign hr_f_bottoms = section.settings.look_scale | times: 0.357 | round: 4
  assign hr_flavours = section.blocks | where: 'type', 'flavour'
  assign hr_first = hr_flavours.first
  assign hr_bg = 'var(--pistachio)'
  if hr_first
    assign hr_bg = hr_first.settings.color
  endif

  assign hr_shuffle_label = section.settings.shuffle_label
  assign hr_cta_label = section.settings.cta_label
  if hr_has_pieces == false
    assign hr_cta_label = section.settings.empty_cta_label
  endif
  assign hr_cta_href = section.settings.empty_cta_link | default: routes.all_products_collection_url
-%}

<section class="hero-reels" data-section="hero">
  <h1 class="visually-hidden">{{ shop.name }}</h1>
  <hero-reels
    class="hero-reels__root"
    data-code-component
    style="background: {{ hr_bg }}; --flavour: {{ hr_bg }};"
  >
    <div class="hero-reels__glow" aria-hidden="true"></div>
    {%- for block in hr_flavours -%}
      {%- assign hr_r = block.settings.color.red | times: 955 | divided_by: 1000.0 | round -%}
      {%- assign hr_gr = block.settings.color.green | times: 955 | divided_by: 1000.0 | round -%}
      {%- assign hr_bl = block.settings.color.blue | times: 955 | divided_by: 1000.0 | round -%}
      <div
        class="hero-reels__word"
        aria-hidden="true"
        {% if forloop.first %}data-active{% endif %}
        style="color: rgb({{ hr_r }}, {{ hr_gr }}, {{ hr_bl }});"
        {{ block.shopify_attributes }}
      >{{ block.settings.name }}</div>
    {%- endfor -%}

    {%- if hr_tops_arr.size > 0 -%}
      <div class="hero-reels__hit" data-row="tops" style="z-index: 3;"></div>
    {%- endif -%}
    {%- if hr_bottoms_arr.size > 0 -%}
      <div class="hero-reels__hit" data-row="bottoms" style="z-index: 1;"></div>
    {%- endif -%}

    <div class="hero-reels__track">
      {%- for hr_row in hr_rows -%}
        {%- if hr_row == 'tops' -%}
          {%- assign hr_arr = hr_tops_arr -%}
          {%- assign hr_sizes = '(max-width: 639px) 46vw, min(30vw, calc((max(100vh, 720px) - ' | append: hr_desk_top | append: 'px) * ' | append: hr_f_tops | append: '))' -%}
        {%- else -%}
          {%- assign hr_arr = hr_bottoms_arr -%}
          {%- assign hr_sizes = '(max-width: 639px) 36vw, min(26vw, calc((max(100vh, 720px) - ' | append: hr_desk_top | append: 'px) * ' | append: hr_f_bottoms | append: '))' -%}
        {%- endif -%}
        {%- assign hr_n = hr_arr.size -%}
        {%- comment -%}
          Photos in the server HTML (src set): what is on screen when the row first shows. With the intro that is the
          spot the row is parked at (parked = -dir * (max(8, n) + 3), dir tops +1, bottoms -1) and one either side, since
          the row spins in from there; without it, the centre and one either side. Everything else (the centre once the
          intro lands, the rest of the ring) gets its src from hero-reels.js, low priority, so it never competes with the
          first photo (see the JSON note below).
        {%- endcomment -%}
        {%- assign hr_park = 8 -%}
        {%- if hr_n > 8 -%}
          {%- assign hr_park = hr_n -%}
        {%- endif -%}
        {%- assign hr_park = hr_park | plus: 3 -%}
        {%- if hr_row == 'tops' -%}
          {%- assign hr_park = 0 | minus: hr_park -%}
        {%- endif -%}
        {%- assign hr_ref = 0 -%}
        {%- if hr_intro -%}
          {%- assign hr_ref = hr_park -%}
        {%- endif -%}
        {%- comment -%}
          fetchpriority="high" goes on ONE image per page: the tops row's first-loaded photo (the parked spot
          while the intro plays, since the row spins in from there, else piece 0). The bottoms row's matching
          photo still loads eagerly but without the priority hint.
        {%- endcomment -%}
        {%- assign hr_first_idx = 0 -%}
        {%- if hr_intro and hr_n > 0 -%}
          {%- assign hr_first_idx = hr_park | modulo: hr_n | plus: hr_n | modulo: hr_n -%}
        {%- endif -%}
        {%- for hr_rec in hr_arr -%}
          {%- assign hr_f = hr_rec | split: '~~' -%}
          {%- assign hr_idx = forloop.index0 -%}
          {%- assign hr_d1 = hr_idx | minus: hr_ref | modulo: hr_n | plus: hr_n | modulo: hr_n -%}
          {%- assign hr_r1 = hr_d1 | times: 2 -%}
          {%- if hr_r1 >= hr_n -%}
            {%- assign hr_d1 = hr_d1 | minus: hr_n -%}
          {%- endif -%}
          {%- if hr_d1 < 0 -%}
            {%- assign hr_d1 = hr_d1 | times: -1 -%}
          {%- endif -%}
          {%- assign hr_load = false -%}
          {%- if hr_d1 <= 1 -%}
            {%- assign hr_load = true -%}
          {%- endif -%}
          {%- assign hr_fp = '' -%}
          {%- if hr_idx == hr_first_idx and hr_row == 'tops' -%}
            {%- assign hr_fp = 'high' -%}
          {%- endif -%}
          {%- unless hr_load -%}
            {%- assign hr_need = hr_need | append: hr_row | append: '~' | append: hr_f[0] | append: '|' -%}
          {%- endunless -%}
          <div class="hero-reels__piece" data-row="{{ hr_row }}" data-idx="{{ hr_idx }}">
            {%- if hr_load -%}
              {%- if hr_fp != blank -%}
                {%- comment -%}
                  LCP preload. Shopify turns image_tag's preload: true into an HTTP `Link: <url>; rel=preload; as=image`
                  header (with imagesrcset / imagesizes), sent before the HTML so the browser starts the download
                  early. A <link rel=preload> in the body would gain nothing (the scanner already finds the <img>),
                  and layout/theme.liquid can't see these variables. The output is discarded on purpose: the visible
                  <img> below stays hand-built. Widths = exactly the srcset widths above; once per page (tops row only).
                {%- endcomment -%}
                {%- assign hr_pre_prod = hr_set -%}
                {%- if hr_set.handle != hr_f[1] -%}
                  {%- assign hr_pre_prod = section.settings.tops_collection.products | where: 'handle', hr_f[1] | first -%}
                {%- endif -%}
                {%- assign hr_pre_media = nil -%}
                {%- for hr_pm in hr_pre_prod.media -%}
                  {%- assign hr_pm_id = hr_pm.id | append: '' -%}
                  {%- if hr_pm_id == hr_f[9] and hr_pm.media_type == 'image' -%}
                    {%- assign hr_pre_media = hr_pm -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if hr_pre_media != nil -%}
                  {%- assign hr_pre_widths = '' -%}
                  {%- for hr_w in hr_widths -%}
                    {%- assign hr_wi = hr_w | strip | plus: 0 -%}
                    {%- if hr_wi <= hr_pre_media.preview_image.width -%}
                      {%- if hr_pre_widths != '' -%}{%- assign hr_pre_widths = hr_pre_widths | append: ',' -%}{%- endif -%}
                      {%- assign hr_pre_widths = hr_pre_widths | append: hr_wi -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if hr_pre_widths == '' -%}
                    {%- assign hr_pre_widths = hr_pre_media.preview_image.width -%}
                  {%- endif -%}
                  {%- assign hr_pre_top = hr_f[6] | plus: 0 -%}
                  {%- # theme-check-disable-next-line UnusedAssign -%}
                  {%- capture hr_preload -%}
                    {{- hr_pre_media | image_url: width: hr_pre_top | image_tag: widths: hr_pre_widths, sizes: hr_sizes, preload: true -}}
                  {%- endcapture -%}
                {%- endif -%}
              {%- endif -%}
              <img
                src="{{ hr_f[4] }}"
                srcset="{{ hr_f[5] }}"
                sizes="{{ hr_sizes }}"
                width="{{ hr_f[6] }}"
                height="{{ hr_f[7] }}"
                alt="{{ hr_f[2] | escape }}"
                draggable="false"
                decoding="async"
                {% if hr_fp != blank %}fetchpriority="high" loading="eager"{% elsif hr_idx == hr_first_idx %}loading="eager"{% else %}fetchpriority="low"{% endif %}
              >
            {%- else -%}
              <img
                sizes="{{ hr_sizes }}"
                width="{{ hr_f[6] }}"
                height="{{ hr_f[7] }}"
                alt=""
                draggable="false"
                decoding="async"
                fetchpriority="low"
              >
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if hr_tops_arr.size > 0 -%}
      <div class="hero-reels__tag-slot" data-tag-row="tops">
        <div class="hero-reels__tag" {% unless hr_intro %}data-show{% endunless %}>
          <span class="hero-reels__tag-name">{{ hr_tf[2] }}</span>
          <span class="hero-reels__tag-price">{% render 'price', price: hr_tf[3] %}</span>
        </div>
      </div>
    {%- endif -%}
    {%- if hr_bottoms_arr.size > 0 -%}
      <div class="hero-reels__tag-slot" data-tag-row="bottoms">
        <div class="hero-reels__tag" {% unless hr_intro %}data-show{% endunless %}>
          <span class="hero-reels__tag-name">{{ hr_bf[2] }}</span>
          <span class="hero-reels__tag-price">{% render 'price', price: hr_bf[3] %}</span>
        </div>
      </div>
    {%- endif -%}

    <div class="hero-reels__bar">
      <div class="hero-reels__left">
        {%- if hr_can_shuffle -%}
          <button type="button" class="hero-reels__shuffle" aria-label="{{ hr_shuffle_label | escape }}" data-shuffle>
            <span class="hero-reels__dice">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
                <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor"/>
                <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                <circle cx="8.5" cy="15.5" r="1.5" fill="currentColor"/>
                <circle cx="15.5" cy="15.5" r="1.5" fill="currentColor"/>
              </svg>
            </span>
            {{ hr_shuffle_label }}
          </button>
          <span class="hero-reels__hint">{{ section.settings.hint }}</span>
        {%- endif -%}
      </div>
      <div class="hero-reels__right">
        <div class="hero-reels__total">
          <span class="hero-reels__total-label">{{ section.settings.total_label }}</span>
          <span class="hero-reels__total-value"{% if hr_intro and hr_has_pieces %} style="opacity: 0.35;"{% endif %}>{% render 'price', price: hr_total %}</span>
        </div>
        <a
          href="{{ hr_cta_href }}"
          class="hero-reels__cta"
          data-add-look
          data-cta-label="{{ section.settings.cta_label | escape }}"
          data-empty-label="{{ section.settings.empty_cta_label | escape }}"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M9 10V6.5a3 3 0 0 1 6 0V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span data-cta-text>{{ hr_cta_label }}</span>
        </a>
      </div>
    </div>

    {%- comment -%}
      Row JSON: "order" is the ring of piece ids; "pieces" holds each id once. src and w (the widest srcset width) are only
      included for ids that have a slot rendered without an image; JS rebuilds the srcset from them and "widths" (same list as
      the server srcset, <= w) and fills those slots, low priority; name and price drive tags and total.
    {%- endcomment -%}
    {%- for hr_row in hr_rows -%}
      {%- if hr_row == 'tops' -%}
        {%- assign hr_arr = hr_tops_arr -%}
      {%- else -%}
        {%- assign hr_arr = hr_bottoms_arr -%}
      {%- endif -%}
      {%- assign hr_emit = '|' -%}
      {%- capture hr_row_json -%}
        {"order": [
          {%- for hr_rec in hr_arr -%}
            {%- assign hr_f = hr_rec | split: '~~' -%}
            {{ hr_f[0] | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ], "pieces": {
          {%- assign hr_first_piece = true -%}
          {%- for hr_rec in hr_arr -%}
            {%- assign hr_f = hr_rec | split: '~~' -%}
            {%- assign hr_ekey = '|' | append: hr_f[0] | append: '|' -%}
            {%- unless hr_emit contains hr_ekey -%}
              {%- assign hr_emit = hr_emit | append: hr_f[0] | append: '|' -%}
              {%- assign hr_nkey = '|' | append: hr_row | append: '~' | append: hr_f[0] | append: '|' -%}
              {%- unless hr_first_piece -%},{%- endunless -%}
              {%- assign hr_first_piece = false -%}
              {{ hr_f[0] | json }}: {"name": {{ hr_f[2] | json }}, "price": {{ hr_f[3] }}
              {%- if hr_f[8] != 'any' -%}
                , "fit": {{ hr_f[8] | json }}
              {%- endif -%}
              {%- if hr_need contains hr_nkey -%}
                , "src": {{ hr_f[4] | json }}, "w": {{ hr_f[6] }}
              {%- endif -%}
              }
            {%- endunless -%}
          {%- endfor -%}
        }}
      {%- endcapture -%}
      {%- if hr_row == 'tops' -%}
        {%- assign hr_tops_json = hr_row_json -%}
      {%- else -%}
        {%- assign hr_bottoms_json = hr_row_json -%}
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-hero-reels-data>
      {
        "config": {
          "autoShuffle": {{ section.settings.auto_shuffle | default: 0 | json }},
          "intro": {{ hr_intro | json }},
          "introDelay": {{ section.settings.intro_delay | default: 0 | json }},
          "curve": {{ section.settings.curve | json }},
          "lookScale": {{ section.settings.look_scale | json }},
          "sideBlur": {{ section.settings.side_blur | json }},
          "spacing": {{ section.settings.spacing | json }},
          "topInset": {{ section.settings.top_inset | divided_by: 100.0 | json }},
          "topSpace": {{ section.settings.top_space | json }},
          "topSpaceMobile": {{ section.settings.top_space_mobile | json }},
          "widths": [{{ hr_widths | join: ',' }}]
        },
        "flavours": [
          {%- for block in hr_flavours -%}
            {"color": {{ block.settings.color | append: '' | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "tops": {{ hr_tops_json }},
        "bottoms": {{ hr_bottoms_json }},
        "products": { {{ hr_products_json }} },
        "strings": {
          "addTheLook": {{ 'reels.add_the_look' | t | json }},
          "addToBag": {{ 'reels.add_to_bag' | t | json }},
          "soldOut": {{ 'reels.sold_out' | t | json }},
          "size": {{ 'reels.size_placeholder' | t | json }},
          "colourLabel": {{ 'reels.colour_label' | t: name: '[name]' | json }},
          "sizeLabel": {{ 'reels.size_label' | t: name: '[name]' | json }},
          "close": {{ 'accessibility.close' | t | json }},
          "error": {{ 'bag.error' | t | json }}
        }
      }
    </script>
  </hero-reels>
</section>

{% schema %}
{
  "name": "Hero reels",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Pieces"
    },
    {
      "type": "collection",
      "id": "tops_collection",
      "label": "Tops collection",
      "info": "Pick this after adding the section: presets cannot include collections."
    },
    {
      "type": "collection",
      "id": "bottoms_collection",
      "label": "Bottoms collection",
      "info": "Pick this after adding the section: presets cannot include collections."
    },
    {
      "type": "product",
      "id": "set_product",
