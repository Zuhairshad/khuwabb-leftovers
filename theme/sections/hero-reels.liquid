      "max": 5,
      "step": 0.1,
      "unit": "s",
      "default": 2.9
    },
    {
      "type": "range",
      "id": "auto_shuffle",
      "label": "Auto shuffle after idle",
      "info": "0 turns it off.",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "curve",
      "label": "Track curve",
      "min": 0,
      "max": 2.5,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "side_blur",
      "label": "Side blur",
      "min": 0,
      "max": 6,
      "step": 0.2,
      "default": 2.4
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Piece spacing",
      "min": 0.6,
      "max": 1.8,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "look_scale",
      "label": "Look size",
      "min": 0.5,
      "max": 1.3,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "top_inset",
      "label": "Top inset",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 11
    },
    {
      "type": "range",
      "id": "top_space",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "top_space_mobile",
      "label": "Top space (phone)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 92
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Hint",
      "default": "Drag any row to restyle"
    },
    {
      "type": "text",
      "id": "shuffle_label",
      "label": "Shuffle button",
      "default": "Shuffle"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "The look"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Add button",
      "default": "Add the look"
    },
    {
      "type": "text",
      "id": "empty_cta_label",
      "label": "Button when there are no pieces",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "empty_cta_link",
      "label": "Link when there are no pieces",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "flavour",
      "name": "Flavour",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Campus"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Backdrop colour",
          "default": "#d5e5be"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero reels",
      "blocks": [
        { "type": "flavour", "settings": { "name": "Campus", "color": "#d5e5be" } },
        { "type": "flavour", "settings": { "name": "Weekend", "color": "#f6c9cf" } },
        { "type": "flavour", "settings": { "name": "Brunch", "color": "#f5e7a6" } },
        { "type": "flavour", "settings": { "name": "Work", "color": "#c9d2f2" } },
        { "type": "flavour", "settings": { "name": "Winter", "color": "#f7d2b8" } }
