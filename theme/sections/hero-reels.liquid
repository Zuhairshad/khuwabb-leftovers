    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "intro",
      "label": "Spin the reels in when the page opens",
      "default": true
    },
    {
      "type": "range",
      "id": "intro_delay",
      "label": "Intro delay",
      "info": "Timed to the page intro. Used only while the page intro is playing; otherwise the reels start at once.",
