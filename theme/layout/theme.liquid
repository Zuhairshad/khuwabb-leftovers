<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'head-meta' -%}
    {%- render 'head-config' -%}
    {%- render 'head-fonts' -%}
    {%- render 'head-styles' -%}
    {%- render 'scoop-intro-styles' -%}
    {{ 'section-header.css' | asset_url | preload_tag: as: 'style' }}
    {%- if template.name == 'index' -%}
      {{ 'section-hero-reels.css' | asset_url | preload_tag: as: 'style' }}
    {%- endif -%}
    <script src="{{ 'money.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'appear.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}">
    {%- comment -%}
      Intro overlay first, so it is in the first chunk of HTML the browser paints
      (it used to be last, and the hero showed for seconds before the intro).
      It is aria-hidden with nothing focusable, so the skip link is still the first tab stop.
    {%- endcomment -%}
    {% sections 'overlay-group' %}
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {%- comment -%} Static so the Section Rendering API can return it by id 'cart-drawer'. {%- endcomment -%}
    {% section 'cart-drawer' %}
  </body>
</html>
