# Shopify store the storefront reads from and checks out on.
# Defaults to the Khuwabb store (lib/shopify-config.mjs); no token needed.
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=citbkj-yj.myshopify.com

# Set to false to pause online checkout without a code change.
# NEXT_PUBLIC_CHECKOUT_ENABLED=true

# Local tests only: makes every catalog variant orderable with fake IDs so the
# bag can be exercised. Ignored by production builds.
# NEXT_PUBLIC_CATALOG_FIXTURE=orderable

# Canonical origin used for metadata, sitemap and JSON-LD; set to the real domain once it's live.
# NEXT_PUBLIC_SITE_URL=https://khuwabb-export-factory-leftovers.vercel.app

# Google Search Console verification token (Settings > Ownership verification > HTML tag); omit to skip the meta tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Signing key for Shopify webhooks (Shopify admin > Settings > Notifications > Webhooks, shown per webhook).
# Required for app/api/shopify-webhook to accept requests.
# SHOPIFY_WEBHOOK_SECRET=

# Vercel deploy hook URL (Project > Settings > Git > Deploy Hooks) the webhook calls to trigger a rebuild.
# VERCEL_DEPLOY_HOOK_URL=

# Optional: a Vercel API token, used to check for an already-queued production
# build before triggering another one (debounces bursts of webhooks).
# VERCEL_API_TOKEN=

# Optional: team ID to pass alongside VERCEL_API_TOKEN, for projects under a team.
# VERCEL_TEAM_ID=

# Instagram feed on the home page (and the JSON at /api/instagram the Shopify theme reads).
# Connect the Instagram account at behold.so, create a JSON feed and paste its link here.
# Without it the section shows the lookbook photos.
# BEHOLD_FEED_URL=

# The brand's Instagram profile link, used by the feed section and the footer icon.
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/<handle>/
