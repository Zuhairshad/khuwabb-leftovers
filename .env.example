# Shopify checkout hand-off (setup only; keep disabled until reviewed).
# The store's Shopify domain, e.g. khuwabb.myshopify.com or khuwabb.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Set to true only after variant IDs are filled in data/catalog-overrides.json
# and a test COD order has been placed and found in Shopify admin.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Local tests only: makes every catalog variant orderable with fake IDs so the
# bag can be exercised. Ignored by production builds.
# NEXT_PUBLIC_CATALOG_FIXTURE=orderable
